			"item": [
				{
					"name": "1.1 Registro de Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.collectionVariables.set('userId', response.userId);",
									"    console.log('✅ Usuario registrado:', response.email);",
									"    console.log('⚠️  Verifica el código SMS antes de hacer login');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test.user@deliversyto.com\",\n  \"password\": \"123456\",\n  \"name\": \"Juan Test\",\n  \"phone\": \"+573001234567\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Registra un nuevo usuario. Se enviará un código de verificación por SMS."
					},
					"response": []
				},
				{
					"name": "1.2 Verificar Código de Usuario",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.access_token) {",
									"        pm.collectionVariables.set('userToken', response.access_token);",
									"        console.log('✅ Email verificado y login automático exitoso');",
									"    } else {",
									"        console.log('✅ Código verificado. Ahora puedes hacer login');",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"userId\": \"{{userId}}\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "verify"]
						},
						"description": "Verifica el código de 6 dígitos enviado por SMS. Obtén el código de la tabla verification_codes o del SMS. Este endpoint hace login automáticamente después de verificar."
					},
					"response": []
				},
